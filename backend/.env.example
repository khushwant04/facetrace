# =========================
# DATABASE (Neon PostgreSQL)
# =========================
DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>/<DB_NAME>


# =========================
# AUTH0 CONFIGURATION
# =========================
AUTH0_DOMAIN=<YOUR_AUTH0_DOMAIN>
AUTH0_API_AUDIENCE=<YOUR_AUTH0_API_AUDIENCE>
AUTH0_ISSUER=<YOUR_AUTH0_ISSUER>
AUTH0_CLIENT_ID=<YOUR_AUTH0_CLIENT_ID>
AUTH0_CLIENT_SECRET=<YOUR_AUTH0_CLIENT_SECRET>


# =========================
# AWS CONFIGURATION
# =========================
AWS_REGION=<AWS_REGION>
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>


# =========================
# AWS S3
# =========================
S3_BUCKET_NAME=<S3_BUCKET_NAME>


# =========================
# AWS REKOGNITION
# =========================
REKOGNITION_COLLECTION_ID=<REKOGNITION_COLLECTION_ID>


# =========================
# REDIS CLOUD
# =========================
REDIS_HOST=<REDIS_HOST>
REDIS_PORT=<REDIS_PORT>
REDIS_USERNAME=<REDIS_USERNAME>
REDIS_PASSWORD=<REDIS_PASSWORD>


# =========================
# APPLICATION SETTINGS
# =========================
APP_NAME=Student Face Recognition SaaS
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development
