# Auth0 (Next.js SDK) - create a "Regular Web Application" in your Auth0 tenant
AUTH0_DOMAIN=<your-tenant>.auth0.com
AUTH0_CLIENT_ID=<auth0-client-id>
AUTH0_CLIENT_SECRET=<auth0-client-secret>
# 32-byte hex string used to encrypt the session cookie: openssl rand -hex 32
AUTH0_SECRET=<random-64-char-hex>
APP_BASE_URL=http://localhost:3000

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
